{
	"name": "@thruput-io/review-tool",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"knip": "knip && knip --strict",
		"lint": "biome check --error-on-warnings",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-exclude='src/**/*.test.ts' 'src/**/*.test.ts'",
		"verify": "npm run knip && npm run lint && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@tsconfig/node24": "24.0.6",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.19.2",
		"archunit": "2.5.5",
		"knip": "6.43.0",
		"typescript": "7.0.2"
	},
	"dependencies": {
		"effect": "4.1.5"
	}
}
