{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "review-tool-answers",
	"description": "What each command of the main agent answers: its answer, or why it failed.",
	"type": "object",
	"properties": {
		"prepare": {
			"description": "How the review that was started stands",
			"anyOf": [
				{
					"$ref": "answers.schema.json#/$defs/Status"
				},
				{
					"$ref": "answers.schema.json"
				}
			]
		},
		"status": {
			"description": "How the review stands",
			"anyOf": [
				{
					"$ref": "answers.schema.json#/$defs/Status"
				},
				{
					"$ref": "answers.schema.json"
				}
			]
		},
		"-h": {
			"description": "The help of the tool",
			"anyOf": [
				{
					"$ref": "answers.schema.json#/$defs/Help"
				}
			]
		}
