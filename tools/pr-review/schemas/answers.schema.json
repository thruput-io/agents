{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "answers",
	"description": "What a command answers when it fails.",
	"type": "object",
	"properties": {
		"failure": {
			"description": "Why the command failed",
			"enum": [
				"not-valid",
				"unknown-format",
				"already-reviewed",
				"too-large",
				"refused",
				"host-error",
				"not-started",
				"no-review",
				"not-defined",
				"not-assigned",
				"no-page",
				"not-acknowledged",
				"workdir-failed"
			]
		}
	},
	"required": ["failure"],
	"$defs": {
		"Status": {
			"description": "How a review stands",
			"type": "object",
			"properties": {
				"remaining": {
					"description": "The rules not yet judged, by their ids",
					"type": "array",
					"items": {
						"$ref": "domain.schema.json#/$defs/Rule"
					}
				},
				"posted": {
					"description": "Whether the review was posted to the host",
					"type": "boolean"
				},
				"postFailed": {
					"description": "Whether posting the review failed",
					"type": "boolean"
				}
			},
			"required": ["remaining", "posted", "postFailed"]
		},
		"Rules": {
			"description": "The rules of a probe",
			"type": "object",
			"properties": {
				"rules": {
					"description": "The rules of the probe, by their ids",
					"type": "array",
					"items": {
						"$ref": "domain.schema.json#/$defs/Rule"
					}
				}
			},
			"required": ["rules"]
		},
		"Standing": {
			"description": "What a probe has left to judge",
			"type": "object",
			"properties": {
				"remaining": {
					"description": "The rules not yet judged, by their ids",
					"type": "array",
					"items": {
						"$ref": "domain.schema.json#/$defs/Rule"
					}
				}
			},
			"required": ["remaining"]
		},
		"Instructions": {
			"description": "What a sub agent is told to do",
			"type": "object",
			"properties": {
				"workflow": {
					"$ref": "domain.schema.json#/$defs/Workflow"
				},
				"context": {
					"$ref": "domain.schema.json#/$defs/Context"
				},
				"usage": {
					"$ref": "domain.schema.json#/$defs/Usage"
				},
				"request": {
					"$ref": "domain.schema.json#/$defs/AcknowledgementRequest"
				}
			},
			"required": ["workflow", "context", "usage", "request"]
		},
		"Help": {
			"description": "What a tool is and what its commands do",
			"type": "object",
			"properties": {
				"description": {
					"description": "What the tool is",
					"type": "string",
					"minLength": 1
				},
				"commands": {
					"description": "Each command with what it does",
					"type": "object",
					"additionalProperties": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": ["description", "commands"]
		}
	}
}
