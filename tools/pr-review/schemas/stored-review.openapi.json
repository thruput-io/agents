{
	"openapi": "3.1.0",
	"info": {
		"title": "stored-review",
		"version": "0.0.0",
		"description": "What the file of a review holds in its workdir, one JSON value on each line: what the review was started from, then everything recorded since, in order."
	},
	"paths": {},
	"components": {
		"schemas": {
			"StoredStart": {
				"description": "What a review was started from",
				"type": "object",
				"properties": {
					"url": {
						"$ref": "domain.openapi.json#/components/schemas/TargetUrl"
					},
					"pages": {
						"description": "The pages of the surface",
						"type": "array",
						"items": {
							"$ref": "domain.openapi.json#/components/schemas/Page"
						}
					},
					"tasks": {
						"description": "What each probe is handed",
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/StoredTask"
						}
					}
				},
				"required": ["url", "pages", "tasks"]
			},
			"StoredTask": {
				"description": "What a probe is handed",
				"type": "object",
				"properties": {
					"probe": {
						"$ref": "domain.openapi.json#/components/schemas/Probe"
					},
					"instructions": {
						"$ref": "review-tool-probe.openapi.json#/components/schemas/Instructions"
					},
					"detailed": {
						"$ref": "review-tool-probe.openapi.json#/components/schemas/Instructions"
					},
					"rules": {
						"description": "The rules the probe judges",
						"type": "array",
						"items": {
							"$ref": "domain.openapi.json#/components/schemas/Rule"
						}
					},
					"glossary": {
						"description": "Each term the probe can ask for, with what it means",
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/StoredDefined"
						}
					}
				},
				"required": ["probe", "instructions", "detailed", "rules", "glossary"]
			},
			"StoredDefined": {
				"description": "A term and what it means",
				"type": "object",
				"properties": {
					"term": {
						"description": "A word of the glossary, as it is looked up",
						"type": "string",
						"minLength": 1
					},
					"definition": {
						"$ref": "domain.openapi.json#/components/schemas/Definition"
					}
				},
				"required": ["term", "definition"]
			},
			"StoredVerdict": {
				"description": "That a rule is judged",
				"type": "object",
				"properties": {
					"rule": {
						"$ref": "domain.openapi.json#/components/schemas/Rule"
					}
				},
				"required": ["rule"]
			},
			"StoredPost": {
				"description": "How posting the review went",
				"type": "string",
				"enum": ["posted", "host-error"]
			},
			"StoredTurn": {
				"description": "The sub agent turned a page: forward to the next, back to the previous",
				"type": "string",
				"enum": ["forward", "back"]
			},
			"StoredSent": {
				"description": "The sub agent acknowledged its instructions",
				"type": "object",
				"properties": {
					"acknowledgement": {
						"$ref": "domain.openapi.json#/components/schemas/Acknowledgement"
					}
				},
				"required": ["acknowledgement"]
			},
			"StoredJudged": {
				"description": "The sub agent judged a rule",
				"type": "object",
				"properties": {
					"verdict": {
						"$ref": "#/components/schemas/StoredVerdict"
					}
				},
				"required": ["verdict"]
			},
			"StoredRecording": {
				"description": "One thing that happened in a review, and the probe it happened to",
				"type": "object",
				"properties": {
					"probe": {
						"$ref": "domain.openapi.json#/components/schemas/Probe"
					},
					"recorded": {
						"description": "What happened",
						"anyOf": [
							{
								"$ref": "#/components/schemas/StoredSent"
							},
							{
								"$ref": "#/components/schemas/StoredJudged"
							},
							{
								"$ref": "#/components/schemas/StoredTurn"
							},
							{
								"$ref": "#/components/schemas/StoredPost"
							}
						]
					}
				},
				"required": ["probe", "recorded"]
			}
		}
	}
}
