{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": "../.."
	},
	"linter": {
		"enabled": true,
		"rules": {
			"a11y": "error",
			"complexity": "error",
			"correctness": "error",
			"nursery": "error",
			"performance": "error",
			"security": "error",
			"style": "error",
			"suspicious": "error"
		}
	},
	"formatter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["**"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off",
						"useQwikValidLexicalScope": "off"
					}
				}
			}
		},
		{
			"includes": ["src/client/main/review-tool.ts"],
			"linter": {
				"rules": {
					"nursery": {
						"noProcessExit": "off"
					}
				}
			}
		},
		{
			"includes": ["src/**/*.narrow-test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noProcessEnv": "off"
					}
				}
			}
		}
	]
}
