{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": "../.."
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"correctness": {
				"noNodejsModules": "off",
				"useQwikValidLexicalScope": "off"
			}
		}
	},
	"formatter": {
		"enabled": true
	}
}
