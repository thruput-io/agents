{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/thruput-review-tool.tgz", "label": "thruput-review-tool.tgz" }
        ]
      }
    ]
  ]
}
