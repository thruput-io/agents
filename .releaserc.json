{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "release": "patch" }
        ]
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "skills/pr-review/dist/bin/review-tool.mjs",
            "label": "review-tool.mjs"
          },
          {
            "path": "skills/pr-review/dist/bin/review-tool-probe.mjs",
            "label": "review-tool-probe.mjs"
          }
        ]
      }
    ]
  ]
}
