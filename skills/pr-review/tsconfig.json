{
	"extends": [
		"@tsconfig/node26/tsconfig.json",
		"@tsconfig/strictest/tsconfig.json"
	],
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noUncheckedSideEffectImports": true
	},
	"exclude": ["node_modules", "schemas", "references"]
}
