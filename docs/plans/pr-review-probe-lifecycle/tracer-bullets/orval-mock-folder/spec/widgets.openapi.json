{
	"openapi": "3.0.3",
	"info": { "title": "Widgets", "version": "1.0.0" },
	"paths": {
		"/widgets/{id}": {
			"get": {
				"operationId": "getWidget",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": { "type": "string" }
					}
				],
				"responses": {
					"200": {
						"description": "The widget",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Widget" }
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Widget": {
				"type": "object",
				"required": ["name"],
				"properties": { "name": { "type": "string", "enum": ["anvil"] } }
			}
		}
	}
}
