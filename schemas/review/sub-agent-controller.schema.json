{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/sub-agent-controller.schema.json",
  "title": "SubAgentController",
  "description": "Sub-agent controller CLI arguments, return objects, and internal acknowledgment and ledger submission representations",
  "oneOf": [
    {
      "$ref": "#/$defs/SubAgentCommand"
    },
    {
      "$ref": "#/$defs/AckRecord"
    },
    {
      "$ref": "#/$defs/CursorRecord"
    },
    {
      "$ref": "#/$defs/AckStatus"
    },
    {
      "$ref": "#/$defs/InstructionsResponse"
    },
    {
      "$ref": "#/$defs/AckResponse"
    },
    {
      "$ref": "#/$defs/DefineResponse"
    },
    {
      "$ref": "#/$defs/PageResponse"
    },
    {
      "$ref": "#/$defs/RulesResponse"
    },
    {
      "$ref": "#/$defs/LedgerSubmission"
    },
    {
      "$ref": "#/$defs/ReportResponse"
    }
  ],
  "$defs": {
    "EpochMs": {
      "description": "Unix timestamp in milliseconds",
      "type": "integer",
      "minimum": 0
    },
    "ToolPermission": {
      "description": "One granted tool permission string",
      "type": "string",
      "minLength": 1
    },
    "InstructionsCommand": {
      "description": "CLI arguments to review-tool-probe.mjs instructions <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "instructions"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "AckPayload": {
      "description": "JSON payload passed to review-tool-probe.mjs ack to verify the subagent can invoke the tool with a JSON object argument",
      "type": "object",
      "required": [
        "acknowledged"
      ],
      "properties": {
        "acknowledged": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "AckCommand": {
      "description": "CLI arguments to review-tool-probe.mjs ack <session> <probe> '<ack-json>'",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe",
        "payload"
      ],
      "properties": {
        "command": {
          "const": "ack"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "payload": {
          "$ref": "#/$defs/AckPayload"
        }
      },
      "additionalProperties": false
    },
    "DefineCommand": {
      "description": "CLI arguments to review-tool-probe.mjs define \"<term>\" [depth]",
      "type": "object",
      "required": [
        "command",
        "term",
        "depth"
      ],
      "properties": {
        "command": {
          "const": "define"
        },
        "term": {
          "$ref": "../governance/definitions.schema.json#/$defs/DefinitionId"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RulesCommand": {
      "description": "CLI arguments to review-tool-probe.mjs rules <session> <probe> [\"<url>\" [page]]",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "rules"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "url": {
          "$ref": "ledger.schema.json#/$defs/RulesetUrl"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "NextCommand": {
      "description": "CLI arguments to review-tool-probe.mjs next <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "next"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "PrevCommand": {
      "description": "CLI arguments to review-tool-probe.mjs prev <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "prev"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "ProbeReport": {
      "description": "Container passed to review-tool-probe.mjs report holding one verdict row per rule in the order named by the probe's instructions",
      "type": "object",
      "required": [
        "oneRowPerRuleInOrder"
      ],
      "properties": {
        "oneRowPerRuleInOrder": {
          "$ref": "ledger.schema.json#/$defs/Rows"
        }
      },
      "additionalProperties": false
    },
    "ReportCommand": {
      "description": "CLI arguments to review-tool-probe.mjs report <session> <probe> '{\"oneRowPerRuleInOrder\": [...]}'",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe",
        "report"
      ],
      "properties": {
        "command": {
          "const": "report"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "report": {
          "$ref": "#/$defs/ProbeReport"
        }
      },
      "additionalProperties": false
    },
    "SubAgentCommand": {
      "description": "CLI command arguments accepted by review-tool-probe.mjs",
      "oneOf": [
        {
          "$ref": "#/$defs/InstructionsCommand"
        },
        {
          "$ref": "#/$defs/AckCommand"
        },
        {
          "$ref": "#/$defs/DefineCommand"
        },
        {
          "$ref": "#/$defs/RulesCommand"
        },
        {
          "$ref": "#/$defs/NextCommand"
        },
        {
          "$ref": "#/$defs/PrevCommand"
        },
        {
          "$ref": "#/$defs/ReportCommand"
        }
      ]
    },
    "AckRecord": {
      "description": "Acknowledgment timestamp persisted to <probe>.ack.json in the ledger directory",
      "type": "object",
      "required": [
        "acknowledgedAt"
      ],
      "properties": {
        "acknowledgedAt": {
          "$ref": "#/$defs/EpochMs"
        }
      },
      "additionalProperties": false
    },
    "CursorRecord": {
      "description": "Current surface page cursor persisted to <probe>.cursor.json in the ledger directory",
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": -1
        }
      },
      "additionalProperties": false
    },
    "AckStatus": {
      "description": "Internal acknowledgment state returned by SubAgentController.ack()",
      "type": "object",
      "required": [
        "acknowledgedAt",
        "deadlineMs",
        "permissions"
      ],
      "properties": {
        "acknowledgedAt": {
          "$ref": "#/$defs/EpochMs"
        },
        "deadlineMs": {
          "description": "Reporting deadline threshold in milliseconds from acknowledgment, determined by the probe",
          "oneOf": [
            {
              "$ref": "agent-instructions.schema.json#/$defs/Probe/oneOf/2/properties/deadlineMs"
            },
            {
              "$ref": "agent-instructions.schema.json#/$defs/Probe/oneOf/0/properties/deadlineMs"
            }
          ]
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolPermission"
          }
        }
      },
      "additionalProperties": false
    },
    "InstructionsSuccess": {
      "description": "Returned by review-tool-probe.mjs instructions with the probe's instructions, permissions, deadlineMs, and optional checkout",
      "type": "object",
      "required": [
        "success",
        "probe",
        "deadlineMs",
        "permissions",
        "instructions"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "deadlineMs": {
          "$ref": "#/$defs/AckStatus/properties/deadlineMs"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolPermission"
          }
        },
        "instructions": {
          "$ref": "../governance/definitions.schema.json#/$defs/Prose"
        },
        "checkout": {
          "$ref": "agent-instructions.schema.json#/$defs/Checkout"
        }
      },
      "additionalProperties": false
    },
    "AckSuccess": {
      "description": "Returned by review-tool-probe.mjs ack when the probe verifies its JSON payload and starts its reporting deadline",
      "type": "object",
      "required": [
        "success",
        "probe",
        "acknowledged",
        "deadlineMs",
        "permissions"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "acknowledged": {
          "const": true
        },
        "deadlineMs": {
          "$ref": "#/$defs/AckStatus/properties/deadlineMs"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolPermission"
          }
        }
      },
      "additionalProperties": false
    },
    "DefineSuccess": {
      "description": "Returned by review-tool-probe.mjs define with the resolved term and nested definitions up to depth levels",
      "type": "object",
      "required": [
        "success",
        "term",
        "depth",
        "definitions"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "term": {
          "$ref": "../governance/definitions.schema.json#/$defs/DefinitionId"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "definitions": {
          "$ref": "../governance/definitions.schema.json#/properties/definitions"
        }
      },
      "additionalProperties": false
    },
    "SurfacePage": {
      "description": "Returned by review-tool-probe.mjs next or prev showing one changed file slice and its surrounding context",
      "type": "object",
      "required": [
        "success",
        "status",
        "page",
        "totalPages",
        "fileIndex",
        "totalFiles",
        "filePage",
        "fileTotalPages",
        "path",
        "fragments"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "status": {
          "const": "page"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 1
        },
        "fileIndex": {
          "type": "integer",
          "minimum": 1
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 1
        },
        "filePage": {
          "type": "integer",
          "minimum": 1
        },
        "fileTotalPages": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "$ref": "change.schema.json#/$defs/Change"
        },
        "path": {
          "$ref": "change.schema.json#/$defs/Path"
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "change.schema.json#/$defs/Fragment"
          }
        }
      },
      "additionalProperties": false
    },
    "SurfaceBoundary": {
      "description": "Returned by review-tool-probe.mjs next or prev when stepping past the first or last changed-file page",
      "type": "object",
      "required": [
        "success",
        "status",
        "totalFiles",
        "totalPages"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "status": {
          "enum": [
            "start",
            "end"
          ]
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        },
        "change": {
          "$ref": "change.schema.json#/$defs/Change"
        }
      },
      "additionalProperties": false
    },
    "RulesSuccess": {
      "description": "Returned by review-tool-probe.mjs rules holding the probe's [[Ruleset]]",
      "type": "object",
      "required": [
        "success",
        "ruleset"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "ruleset": {
          "$ref": "agent-instructions.schema.json#/$defs/Ruleset"
        }
      },
      "additionalProperties": false
    },
    "RulesetsSuccess": {
      "description": "Returned by review-tool-probe.mjs rules when listing external rulebook summaries",
      "type": "object",
      "required": [
        "success",
        "rulesets"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "rulesets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "agent-instructions.schema.json#/$defs/RulebookSummary"
          }
        }
      },
      "additionalProperties": false
    },
    "RulesetPage": {
      "description": "Returned by review-tool-probe.mjs rules <session> <probe> \"<url>\" [page] holding one text page of an external rulebook",
      "type": "object",
      "required": [
        "success",
        "url",
        "title",
        "page",
        "totalPages",
        "text"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "url": {
          "$ref": "ledger.schema.json#/$defs/RulesetUrl"
        },
        "title": {
          "$ref": "agent-instructions.schema.json#/$defs/RulesetTitle"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "$ref": "controller.schema.json#/$defs/RulesetText"
        }
      },
      "additionalProperties": false
    },
    "SubAgentError": {
      "description": "Returned by review-tool-probe.mjs when an argument, ack payload, or ledger row is rejected",
      "type": "object",
      "required": [
        "success",
        "error"
      ],
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "$ref": "controller.schema.json#/$defs/ErrorMessage"
        }
      },
      "additionalProperties": false
    },
    "InstructionsResponse": {
      "description": "CLI return object of review-tool-probe.mjs instructions",
      "oneOf": [
        {
          "$ref": "#/$defs/InstructionsSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "AckResponse": {
      "description": "CLI return object of review-tool-probe.mjs ack",
      "oneOf": [
        {
          "$ref": "#/$defs/AckSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "DefineResponse": {
      "description": "CLI return object of review-tool-probe.mjs define",
      "oneOf": [
        {
          "$ref": "#/$defs/DefineSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "PageResponse": {
      "description": "CLI return object of review-tool-probe.mjs next and prev",
      "oneOf": [
        {
          "$ref": "#/$defs/SurfacePage"
        },
        {
          "$ref": "#/$defs/SurfaceBoundary"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "RulesResponse": {
      "description": "CLI return object of review-tool-probe.mjs rules",
      "oneOf": [
        {
          "$ref": "#/$defs/RulesSuccess"
        },
        {
          "$ref": "#/$defs/RulesetsSuccess"
        },
        {
          "$ref": "#/$defs/RulesetPage"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "LedgerRecorded": {
      "description": "Internal submission state when a probe slice is recorded to disk and other probes are still pending",
      "type": "object",
      "required": [
        "kind",
        "ledger"
      ],
      "properties": {
        "kind": {
          "const": "recorded"
        },
        "ledger": {
          "$ref": "ledger.schema.json"
        }
      },
      "additionalProperties": false
    },
    "LedgerSubmitted": {
      "description": "Internal submission state when the last pending probe reports and the merged ledger and outcome are finalized",
      "type": "object",
      "required": [
        "kind",
        "ledger",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "submitted"
        },
        "ledger": {
          "$ref": "ledger.schema.json"
        },
        "outcome": {
          "$ref": "controller.schema.json#/$defs/Outcome"
        },
        "location": {
          "$ref": "controller.schema.json#/$defs/LocationUrl"
        }
      },
      "additionalProperties": false
    },
    "LedgerSubmission": {
      "description": "Internal return value of SubAgentController.report()",
      "oneOf": [
        {
          "$ref": "#/$defs/LedgerRecorded"
        },
        {
          "$ref": "#/$defs/LedgerSubmitted"
        }
      ]
    },
    "ReportSuccess": {
      "description": "Returned by review-tool-probe.mjs report when all rows for the probe slice pass validation and are recorded",
      "type": "object",
      "required": [
        "success",
        "kind",
        "headCommit",
        "rowCount"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "kind": {
          "enum": [
            "recorded",
            "submitted"
          ]
        },
        "headCommit": {
          "$ref": "change.schema.json#/$defs/HeadCommit"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        },
        "location": {
          "$ref": "controller.schema.json#/$defs/LocationUrl"
        }
      },
      "additionalProperties": false
    },
    "ReportResponse": {
      "description": "CLI return object of review-tool-probe.mjs report",
      "oneOf": [
        {
          "$ref": "#/$defs/ReportSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    }
  },
  "examples": [
    {
      "success": true,
      "probe": "01-purpose",
      "acknowledged": true,
      "deadlineMs": 300000,
      "permissions": [
        "Bash(review-tool-probe.mjs*)"
      ]
    }
  ]
}
