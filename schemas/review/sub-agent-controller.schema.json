{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/sub-agent-controller.schema.json",
  "title": "SubAgentController",
  "description": "Sub-agent controller CLI arguments, return objects, and internal acknowledgment and ledger submission representations",
  "oneOf": [
    {
      "$ref": "#/$defs/SubAgentCommand"
    },
    {
      "$ref": "#/$defs/AckRecord"
    },
    {
      "$ref": "#/$defs/CursorRecord"
    },
    {
      "$ref": "#/$defs/AckStatus"
    },
    {
      "$ref": "#/$defs/AckResponse"
    },
    {
      "$ref": "#/$defs/DefineResponse"
    },
    {
      "$ref": "#/$defs/PageResponse"
    },
    {
      "$ref": "#/$defs/RulesetPageResponse"
    },
    {
      "$ref": "#/$defs/LedgerSubmission"
    },
    {
      "$ref": "#/$defs/ReportResponse"
    }
  ],
  "$defs": {
    "EpochMs": {
      "description": "Unix timestamp in milliseconds",
      "type": "integer",
      "minimum": 0
    },
    "DeadlineMs": {
      "description": "Reporting deadline in milliseconds from acknowledgment (5 minutes)",
      "const": 300000
    },
    "ToolPermission": {
      "description": "One granted tool permission string",
      "type": "string",
      "minLength": 1
    },
    "InspectCommand": {
      "description": "CLI arguments to review-tool-probe inspect <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "inspect"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "DefineCommand": {
      "description": "CLI arguments to review-tool-probe define \"<term>\" [depth]",
      "type": "object",
      "required": [
        "command",
        "term",
        "depth"
      ],
      "properties": {
        "command": {
          "const": "define"
        },
        "term": {
          "$ref": "../governance/definitions.schema.json#/$defs/DefinitionId"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "ObservationFormat": {
      "description": "Sentence pattern that every Violation observation must complete",
      "const": "<observation> breaks <principle>"
    },
    "RulesAckPayload": {
      "description": "JSON acknowledgment payload for rules, dead-code, and reuse probes confirming receipt of the dispatcher message, rule order, and observation contract",
      "type": "object",
      "required": [
        "message",
        "rulesInOrder",
        "observationFormat"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "rulesInOrder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../governance/rules.schema.json#/$defs/RuleId"
          }
        },
        "observationFormat": {
          "$ref": "#/$defs/ObservationFormat"
        }
      },
      "additionalProperties": false
    },
    "ContextAckPayload": {
      "description": "JSON acknowledgment payload for the context probe confirming receipt of the dispatcher message, 3-row bookRule expectation, and observation contract",
      "type": "object",
      "required": [
        "message",
        "bookRuleRows",
        "observationFormat"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "bookRuleRows": {
          "const": 3
        },
        "observationFormat": {
          "$ref": "#/$defs/ObservationFormat"
        }
      },
      "additionalProperties": false
    },
    "AckPayload": {
      "description": "JSON payload passed to review-tool-probe ack confirming dispatcher message receipt and report contract readiness",
      "oneOf": [
        {
          "$ref": "#/$defs/RulesAckPayload"
        },
        {
          "$ref": "#/$defs/ContextAckPayload"
        }
      ]
    },
    "AckCommand": {
      "description": "CLI arguments to review-tool-probe ack <session> <probe> '<ack-json>'",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe",
        "payload"
      ],
      "properties": {
        "command": {
          "const": "ack"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "payload": {
          "$ref": "#/$defs/AckPayload"
        }
      },
      "additionalProperties": false
    },
    "NextCommand": {
      "description": "CLI arguments to review-tool-probe next <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "next"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "PrevCommand": {
      "description": "CLI arguments to review-tool-probe prev <session> <probe>",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe"
      ],
      "properties": {
        "command": {
          "const": "prev"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        }
      },
      "additionalProperties": false
    },
    "RulesetCommand": {
      "description": "CLI arguments to review-tool-probe ruleset <session> <probe> \"<url>\" [page]",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe",
        "url",
        "page"
      ],
      "properties": {
        "command": {
          "const": "ruleset"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "url": {
          "$ref": "ledger.schema.json#/$defs/RulesetUrl"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ProbeReport": {
      "description": "Container passed to review-tool-probe report holding one verdict row per rule in the order named by the probe's task",
      "type": "object",
      "required": [
        "oneRowPerRuleInOrder"
      ],
      "properties": {
        "oneRowPerRuleInOrder": {
          "$ref": "ledger.schema.json#/$defs/Rows"
        }
      },
      "additionalProperties": false
    },
    "ReportCommand": {
      "description": "CLI arguments to review-tool-probe report <session> <probe> '{\"oneRowPerRuleInOrder\": [...]}'",
      "type": "object",
      "required": [
        "command",
        "session",
        "probe",
        "report"
      ],
      "properties": {
        "command": {
          "const": "report"
        },
        "session": {
          "$ref": "controller.schema.json#/$defs/SessionToken"
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "report": {
          "$ref": "#/$defs/ProbeReport"
        }
      },
      "additionalProperties": false
    },
    "SubAgentCommand": {
      "description": "CLI command arguments accepted by review-tool-probe",
      "oneOf": [
        {
          "$ref": "#/$defs/DefineCommand"
        },
        {
          "$ref": "#/$defs/InspectCommand"
        },
        {
          "$ref": "#/$defs/AckCommand"
        },
        {
          "$ref": "#/$defs/NextCommand"
        },
        {
          "$ref": "#/$defs/PrevCommand"
        },
        {
          "$ref": "#/$defs/RulesetCommand"
        },
        {
          "$ref": "#/$defs/ReportCommand"
        }
      ]
    },
    "AckRecord": {
      "description": "Acknowledgment timestamp persisted to <probe>.ack.json in the ledger directory",
      "type": "object",
      "required": [
        "acknowledgedAt"
      ],
      "properties": {
        "acknowledgedAt": {
          "$ref": "#/$defs/EpochMs"
        }
      },
      "additionalProperties": false
    },
    "CursorRecord": {
      "description": "Current surface page cursor persisted to <probe>.cursor.json in the ledger directory",
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": -1
        }
      },
      "additionalProperties": false
    },
    "DefineSuccess": {
      "description": "Returned by review-tool-probe define with the resolved term and nested definitions up to depth levels",
      "type": "object",
      "required": [
        "success",
        "term",
        "depth",
        "definitions"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "term": {
          "$ref": "../governance/definitions.schema.json#/$defs/DefinitionId"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "definitions": {
          "$ref": "../governance/definitions.schema.json#/properties/definitions"
        }
      },
      "additionalProperties": false
    },
    "SurfacePage": {
      "description": "Returned by review-tool-probe next or prev showing one page of a grouped changed file and its context",
      "type": "object",
      "required": [
        "success",
        "status",
        "page",
        "totalPages",
        "fileIndex",
        "totalFiles",
        "filePage",
        "fileTotalPages",
        "path",
        "fragments"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "status": {
          "const": "page"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 1
        },
        "fileIndex": {
          "type": "integer",
          "minimum": 1
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 1
        },
        "filePage": {
          "type": "integer",
          "minimum": 1
        },
        "fileTotalPages": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "$ref": "change.schema.json#/$defs/Path"
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "change.schema.json#/$defs/Fragment"
          }
        }
      },
      "additionalProperties": false
    },
    "SurfaceBoundary": {
      "description": "Returned by review-tool-probe next or prev when stepping past the first or last changed-file page",
      "type": "object",
      "required": [
        "success",
        "status",
        "totalFiles",
        "totalPages"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "status": {
          "enum": [
            "start",
            "end"
          ]
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "RulesetPage": {
      "description": "Returned by review-tool-probe ruleset holding one bounded text page of an external rulebook",
      "type": "object",
      "required": [
        "success",
        "url",
        "title",
        "page",
        "totalPages",
        "text"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "url": {
          "$ref": "ledger.schema.json#/$defs/RulesetUrl"
        },
        "title": {
          "$ref": "agent-instructions.schema.json#/$defs/RulesetTitle"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "totalPages": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "$ref": "controller.schema.json#/$defs/RulesetText"
        }
      },
      "additionalProperties": false
    },
    "AckStatus": {
      "description": "Internal acknowledgment state returned by SubAgentController.ack()",
      "type": "object",
      "required": [
        "acknowledgedAt",
        "deadlineMs",
        "permissions"
      ],
      "properties": {
        "acknowledgedAt": {
          "$ref": "#/$defs/EpochMs"
        },
        "deadlineMs": {
          "$ref": "#/$defs/DeadlineMs"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolPermission"
          }
        }
      },
      "additionalProperties": false
    },
    "AckSuccess": {
      "description": "Returned by review-tool-probe ack when the dispatcher message is verified and the 5-minute deadline starts",
      "type": "object",
      "required": [
        "success",
        "probe",
        "acknowledged",
        "deadlineMs",
        "permissions"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "probe": {
          "$ref": "controller.schema.json#/$defs/ProbeName"
        },
        "acknowledged": {
          "const": true
        },
        "deadlineMs": {
          "$ref": "#/$defs/DeadlineMs"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ToolPermission"
          }
        }
      },
      "additionalProperties": false
    },
    "SubAgentError": {
      "description": "Returned by review-tool-probe when an argument, ack message, or ledger row is rejected",
      "type": "object",
      "required": [
        "success",
        "error"
      ],
      "properties": {
        "success": {
          "const": false
        },
        "error": {
          "$ref": "controller.schema.json#/$defs/ErrorMessage"
        }
      },
      "additionalProperties": false
    },
    "AckResponse": {
      "description": "CLI return object of review-tool-probe ack",
      "oneOf": [
        {
          "$ref": "#/$defs/AckSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "DefineResponse": {
      "description": "CLI return object of review-tool-probe define",
      "oneOf": [
        {
          "$ref": "#/$defs/DefineSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "PageResponse": {
      "description": "CLI return object of review-tool-probe next and prev",
      "oneOf": [
        {
          "$ref": "#/$defs/SurfacePage"
        },
        {
          "$ref": "#/$defs/SurfaceBoundary"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "RulesetPageResponse": {
      "description": "CLI return object of review-tool-probe ruleset",
      "oneOf": [
        {
          "$ref": "#/$defs/RulesetPage"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    },
    "LedgerRecorded": {
      "description": "Internal submission state when a probe slice is recorded to disk and other probes are still pending",
      "type": "object",
      "required": [
        "kind",
        "ledger"
      ],
      "properties": {
        "kind": {
          "const": "recorded"
        },
        "ledger": {
          "$ref": "ledger.schema.json"
        }
      },
      "additionalProperties": false
    },
    "LedgerSubmitted": {
      "description": "Internal submission state when the last pending probe reports and the merged ledger and outcome are finalized",
      "type": "object",
      "required": [
        "kind",
        "ledger",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "submitted"
        },
        "ledger": {
          "$ref": "ledger.schema.json"
        },
        "outcome": {
          "$ref": "controller.schema.json#/$defs/Outcome"
        }
      },
      "additionalProperties": false
    },
    "LedgerSubmission": {
      "description": "Internal return value of SubAgentController.report()",
      "oneOf": [
        {
          "$ref": "#/$defs/LedgerRecorded"
        },
        {
          "$ref": "#/$defs/LedgerSubmitted"
        }
      ]
    },
    "ReportSuccess": {
      "description": "Returned by review-tool-probe report when all rows for the probe slice pass validation and are recorded",
      "type": "object",
      "required": [
        "success",
        "kind",
        "headCommit",
        "rowCount"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "kind": {
          "enum": [
            "recorded",
            "submitted"
          ]
        },
        "headCommit": {
          "$ref": "change.schema.json#/$defs/HeadCommit"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ReportResponse": {
      "description": "CLI return object of review-tool-probe report",
      "oneOf": [
        {
          "$ref": "#/$defs/ReportSuccess"
        },
        {
          "$ref": "#/$defs/SubAgentError"
        }
      ]
    }
  },
  "examples": [
    {
      "success": true,
      "probe": "01-purpose",
      "acknowledged": true,
      "deadlineMs": 300000,
      "permissions": [
        "Bash(review-tool-probe*)"
      ]
    }
  ]
}
