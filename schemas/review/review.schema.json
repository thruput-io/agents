{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/review.schema.json",
  "title": "Review",
  "description": "The review context handed to a probe: the pull request, head commit, fragmented files on the surface, ledger path, and report command",
  "type": "object",
  "required": [
    "pullRequest",
    "headCommit",
    "files",
    "ledger",
    "report"
  ],
  "properties": {
    "pullRequest": {
      "$ref": "pull-request.schema.json"
    },
    "headCommit": {
      "$ref": "change-set.schema.json#/$defs/Commit"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FileUnderReview"
      }
    },
    "ledger": {
      "$ref": "#/$defs/LedgerFile"
    },
    "report": {
      "$ref": "#/$defs/ReportCommand"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "FileUnderReview": {
      "description": "One changed file cut into context and surface fragments",
      "type": "object",
      "required": [
        "path",
        "fragments"
      ],
      "properties": {
        "path": {
          "$ref": "change-set.schema.json#/$defs/Path"
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "fragment.schema.json"
          }
        }
      },
      "additionalProperties": false
    },
    "LedgerFile": {
      "description": "Path where the probe writes its ledger JSON",
      "type": "string",
      "minLength": 1
    },
    "ReportCommand": {
      "description": "Command the probe runs to validate its ledger against its instructions",
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "pullRequest": {
        "host": {
          "kind": "github",
          "owner": "thruput-io",
          "repository": "agents",
          "number": 12
        },
        "author": "agent-rasmus[bot]",
        "description": "A published site is valid and its links hold. Verify runs html-validate and lychee."
      },
      "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
      "files": [
        {
          "path": "scripts/verify.sh",
          "fragments": [
            {
              "kind": "context",
              "lines": {
                "20": "npx --yes @sourcemeta/jsonschema@17.0.0 lint \"$PROJECT_ROOT/schemas\""
              }
            },
            {
              "kind": "surface",
              "side": "head",
              "lines": {
                "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\" || true"
              }
            },
            {
              "kind": "surface",
              "side": "base",
              "lines": {
                "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\""
              }
            }
          ]
        }
      ],
      "ledger": "$WORKDIR/ledger/11-behavior-failure-handling.json",
      "report": "node \"$SKILL_DIR/scripts/check.mjs\" \"$WORKDIR/instructions/11-behavior-failure-handling.yaml\""
    }
  ]
}
