{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/fragment.schema.json",
  "title": "Fragment",
  "description": "A run of consecutive numbered lines of a file: a surface fragment added or removed by the [[Change]], or a context fragment around it",
  "oneOf": [
    {
      "$ref": "#/$defs/SurfaceFragment"
    },
    {
      "$ref": "#/$defs/ContextFragment"
    }
  ],
  "$defs": {
    "SurfaceFragment": {
      "description": "Lines under review on side head or base that a violation may anchor on",
      "type": "object",
      "required": [
        "kind",
        "side",
        "lines"
      ],
      "properties": {
        "kind": {
          "const": "surface"
        },
        "side": {
          "$ref": "lines.schema.json#/$defs/Side"
        },
        "lines": {
          "$ref": "lines.schema.json#/$defs/NumberedLines"
        }
      },
      "additionalProperties": false
    },
    "ContextFragment": {
      "description": "Unchanged surrounding lines at head; no violation anchors on them",
      "type": "object",
      "required": [
        "kind",
        "lines"
      ],
      "properties": {
        "kind": {
          "const": "context"
        },
        "lines": {
          "$ref": "lines.schema.json#/$defs/NumberedLines"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "kind": "surface",
      "side": "head",
      "lines": {
        "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\" || true"
      }
    },
    {
      "kind": "context",
      "lines": {
        "20": "npx --yes @sourcemeta/jsonschema@17.0.0 lint \"$PROJECT_ROOT/schemas\""
      }
    }
  ]
}
