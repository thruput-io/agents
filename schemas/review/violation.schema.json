{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/violation.schema.json",
  "title": "Violation",
  "description": "One finding on a violated rule: the observation of what is wrong and the anchor where it sits",
  "type": "object",
  "required": [
    "observation",
    "anchor"
  ],
  "properties": {
    "observation": {
      "$ref": "#/$defs/Observation"
    },
    "anchor": {
      "$ref": "#/$defs/Anchor"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Observation": {
      "description": "Subject phrase completing '{observation} breaks {principle}', naming no rule or principle",
      "type": "string",
      "minLength": 1
    },
    "Anchor": {
      "description": "Where the violation is anchored: on surface lines or at the pull request",
      "oneOf": [
        {
          "$ref": "#/$defs/SurfaceAnchor"
        },
        {
          "$ref": "#/$defs/PullRequestAnchor"
        }
      ]
    },
    "SurfaceAnchor": {
      "description": "Lines copied verbatim from one surface fragment of review.files",
      "type": "object",
      "required": [
        "kind",
        "path",
        "side",
        "lines"
      ],
      "properties": {
        "kind": {
          "const": "surface"
        },
        "path": {
          "$ref": "change-set.schema.json#/$defs/Path"
        },
        "side": {
          "$ref": "lines.schema.json#/$defs/Side"
        },
        "lines": {
          "$ref": "lines.schema.json#/$defs/NumberedLines"
        }
      },
      "additionalProperties": false
    },
    "PullRequestAnchor": {
      "description": "The pull request as a whole when no surface line is to blame",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "pull-request"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "observation": "Losing the check's exit status in a pipe into tail",
      "anchor": {
        "kind": "surface",
        "path": "scripts/verify.sh",
        "side": "head",
        "lines": {
          "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\" || true"
        }
      }
    },
    {
      "observation": "Writing a new diff parser where parseDiff in skills/pr-review/scripts/lib.mjs already serves",
      "anchor": {
        "kind": "pull-request"
      }
    }
  ]
}
