{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/instructions/escalation.schema.json",
  "title": "Escalation instructions",
  "description": "The instructions of the escalation probe",
  "examples": [
    {
      "kind": "escalation",
      "review": {
        "pullRequest": {
          "host": {
            "kind": "github",
            "owner": "thruput-io",
            "repository": "agents",
            "number": 12
          },
          "author": "agent-rasmus[bot]",
          "reviewer": "review4thruput",
          "description": "A published site is valid and its links hold. Verify runs html-validate and lychee."
        },
        "changeSet": {
          "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
          "files": [
            {
              "path": "scripts/verify.sh",
              "added": [
                {
                  "start": 21,
                  "end": 21
                }
              ],
              "removed": []
            }
          ]
        },
        "surface": {
          "files": [
            {
              "path": "scripts/verify.sh",
              "added": [
                {
                  "start": 21,
                  "end": 21
                }
              ],
              "removed": []
            }
          ]
        },
        "files": [
          {
            "path": "scripts/verify.sh",
            "content": "#!/usr/bin/env bash\nset -euo pipefail\n"
          }
        ],
        "ledger": "/home/user/review/ledger/24-escalation.json"
      },
      "rulesets": [
        {
          "url": "https://github.com/ciembor/agent-rules-books/blob/main/domain-driven-design/domain-driven-design.md",
          "title": "Domain-Driven Design",
          "focus": "Domain Modeling & Strategic Architecture",
          "whenToUse": "Strategic & Tactical modeling. Solves database/controller leakage into business rules.",
          "text": "# Domain-Driven Design\n\n## Make implicit concepts explicit\n"
        }
      ]
    }
  ],
  "type": "object",
  "required": [
    "kind",
    "review",
    "rulesets"
  ],
  "properties": {
    "kind": {
      "const": "escalation"
    },
    "review": {
      "$ref": "../review.schema.json"
    },
    "rulesets": {
      "description": "The rulesets from outside our rules, each read once by the reviewing context and handed over whole. The probe selects the one whose focus matches the change",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Ruleset"
      }
    }
  },
  "$defs": {
    "Ruleset": {
      "description": "One ruleset from outside our rules: what it is for, and its rules in full",
      "type": "object",
      "required": [
        "url",
        "title",
        "focus",
        "whenToUse",
        "text"
      ],
      "properties": {
        "url": {
          "$ref": "../ledger.schema.json#/$defs/RulesetUrl"
        },
        "title": {
          "$ref": "#/$defs/RulesetTitle"
        },
        "focus": {
          "$ref": "#/$defs/RulesetFocus"
        },
        "whenToUse": {
          "$ref": "#/$defs/RulesetUse"
        },
        "text": {
          "$ref": "#/$defs/RulesetText"
        }
      }
    },
    "RulesetTitle": {
      "description": "What a ruleset is called",
      "type": "string",
      "minLength": 1
    },
    "RulesetFocus": {
      "description": "The kind of change a ruleset is about",
      "type": "string",
      "minLength": 1
    },
    "RulesetUse": {
      "description": "When a ruleset is the one to apply, and what it solves",
      "type": "string",
      "minLength": 1
    },
    "RulesetText": {
      "description": "The rules of a ruleset in full, each under its heading",
      "type": "string",
      "minLength": 1
    }
  }
}
