      "rulebook": {
        "rules": [
          {
            "id": "No suppressed exit status",
            "marker": "MUST NOT",
            "group": "Behavior & Failure Handling",
            "parent": "Fail fast",
            "body": "Discard a command's non-zero [[Exit status]] so that a failure passes as success."
          }
        ],
        "principles": [
          {
            "id": "Fail fast",
            "parent": "Crash, don't guess",
            "body": "A system fails loudly and at once on an unexpected state; it never continues on a guess."
          }
        ],
        "rationales": [
          {
            "id": "Crash, don't guess",
            "parent": "Shift Left",
            "body": "A program that continues past an unexpected state runs on a guess."
          }
        ],
        "definitions": [
          {
            "id": "Exit status",
            "specification": "The number a process returns when it ends; zero means success, anything else failure."
          }
        ]
      }
