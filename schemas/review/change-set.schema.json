{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/change-set.schema.json",
  "title": "Change set",
  "description": "The lines a [[Change]] adds at the head commit or removes from the base",
  "type": "object",
  "required": [
    "headCommit",
    "files"
  ],
  "properties": {
    "headCommit": {
      "$ref": "#/$defs/Commit"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ChangedFile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Commit": {
      "description": "A commit SHA-1",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "Path": {
      "description": "A file path relative to the repository root",
      "type": "string",
      "pattern": "^[^/]"
    },
    "ChangedFile": {
      "description": "One file touched by the [[Change]]: added line ranges at head and removed lines with their text at base",
      "type": "object",
      "required": [
        "path",
        "added",
        "removed"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "lines.schema.json#/$defs/LineRange"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "lines.schema.json#/$defs/RemovedLines"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
      "files": [
        {
          "path": "scripts/verify.sh",
          "added": [
            {
              "start": 21,
              "end": 21
            }
          ],
          "removed": [
            {
              "start": 21,
              "end": 21,
              "content": "lychee --offline \"$site\""
            }
          ]
        }
      ]
    }
  ]
}
