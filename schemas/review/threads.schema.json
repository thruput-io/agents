{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/threads.schema.json",
  "title": "Threads",
  "description": "Prior review threads folded at the [[Perimeter]] from the host",
  "type": "object",
  "required": [
    "threads"
  ],
  "properties": {
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Thread"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Thread": {
      "description": "One review thread on lines of the pull request",
      "type": "object",
      "required": [
        "id",
        "path",
        "side",
        "lines",
        "state",
        "body"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ThreadId"
        },
        "path": {
          "$ref": "change-set.schema.json#/$defs/Path"
        },
        "side": {
          "$ref": "lines.schema.json#/$defs/Side"
        },
        "lines": {
          "$ref": "lines.schema.json#/$defs/LineRange"
        },
        "state": {
          "$ref": "#/$defs/ThreadState"
        },
        "body": {
          "$ref": "#/$defs/ThreadBody"
        }
      },
      "additionalProperties": false
    },
    "ThreadId": {
      "description": "Host identifier for the thread",
      "type": "string",
      "minLength": 1
    },
    "ThreadState": {
      "description": "open, resolved-by-author, or resolved by another reviewer",
      "enum": [
        "open",
        "resolved-by-author",
        "resolved"
      ]
    },
    "ThreadBody": {
      "description": "First comment body citing the violated principle",
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "threads": [
        {
          "id": "PRRT_kwDOABCDEF",
          "path": "scripts/verify.sh",
          "side": "head",
          "lines": {
            "start": 21,
            "end": 21
          },
          "state": "open",
          "body": "A failing command passes as success breaks [Fail fast](https://thruput.se/agents/#fail-fast)"
        }
      ]
    }
  ]
}
