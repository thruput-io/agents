{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/surface.schema.json",
  "title": "Surface",
  "description": "The [[Surface]] at the [[Head commit]], resolved once and handed to every probe: each file with its surface fragments on the left (base) and right (head), which a [[Violation]] may anchor on, and context fragments around them",
  "type": "object",
  "required": [
    "headCommit",
    "files"
  ],
  "properties": {
    "headCommit": {
      "$ref": "#/$defs/HeadCommit"
    },
    "files": {
      "description": "Every file that has [[Surface]] lines, whole: its fragments in file order at the [[Head commit]], then the base-side surface fragments",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SurfaceFile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "HeadCommit": {
      "description": "The [[Head commit]], named by its full SHA-1",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "Path": {
      "description": "A file on the [[Surface]], by its path relative to the repository root, with no leading separator",
      "type": "string",
      "pattern": "^[^/]"
    },
    "SurfaceFile": {
      "description": "One file that has [[Surface]] lines, whole: its fragments in file order at the [[Head commit]], then the base-side surface fragments",
      "type": "object",
      "required": [
        "path",
        "fragments"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "fragment.schema.json"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
      "files": [
        {
          "path": "scripts/verify.sh",
          "fragments": [
            {
              "kind": "context",
              "lines": {
                "20": "npx --yes @sourcemeta/jsonschema@17.0.0 lint \"$PROJECT_ROOT/schemas\""
              }
            },
            {
              "kind": "surface",
              "side": "head",
              "lines": {
                "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\" || true"
              }
            },
            {
              "kind": "surface",
              "side": "base",
              "lines": {
                "21": "npx --yes @sourcemeta/jsonschema@17.0.0 metaschema \"$PROJECT_ROOT/schemas\""
              }
            }
          ]
        }
      ]
    }
  ]
}
