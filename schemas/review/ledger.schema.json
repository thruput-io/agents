{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/ledger.schema.json",
  "title": "Ledger",
  "description": "Completeness record of a review at the head commit: one row per rule probed with what was examined, the verdict, and [[Evidence]]",
  "type": "object",
  "required": [
    "headCommit",
    "rows"
  ],
  "properties": {
    "headCommit": {
      "$ref": "change-set.schema.json#/$defs/Commit"
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Row"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Row": {
      "description": "One verdict row for a governance rule or an external book rule",
      "oneOf": [
        {
          "$ref": "#/$defs/RuleRow"
        },
        {
          "$ref": "#/$defs/BookRow"
        }
      ]
    },
    "RuleRow": {
      "description": "Verdict row for a governance rule by [[Id]]",
      "$ref": "#/$defs/Verdict",
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "$ref": "../governance/rules.schema.json#/$defs/RuleId"
        }
      }
    },
    "BookRow": {
      "description": "Verdict row for an external ruleset rule",
      "$ref": "#/$defs/Verdict",
      "required": [
        "bookRule"
      ],
      "properties": {
        "bookRule": {
          "$ref": "#/$defs/BookRule"
        }
      }
    },
    "BookRule": {
      "description": "External rule identified by ruleset URL and heading",
      "type": "object",
      "required": [
        "ruleset",
        "heading"
      ],
      "properties": {
        "ruleset": {
          "$ref": "#/$defs/RulesetUrl"
        },
        "heading": {
          "$ref": "#/$defs/BookRuleHeading"
        }
      },
      "additionalProperties": false
    },
    "RulesetUrl": {
      "description": "Canonical URL of the external ruleset",
      "type": "string",
      "format": "uri"
    },
    "BookRuleHeading": {
      "description": "Heading of the rule in the ruleset",
      "type": "string",
      "minLength": 1
    },
    "Verdict": {
      "description": "Outcome reached on a rule: violation, clean, or not-applicable",
      "oneOf": [
        {
          "$ref": "#/$defs/Violated"
        },
        {
          "$ref": "#/$defs/Clean"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ]
    },
    "Violated": {
      "description": "Violated rule with [[Evidence]] and anchored violations",
      "$ref": "#/$defs/Audited",
      "required": [
        "verdict",
        "violations"
      ],
      "properties": {
        "verdict": {
          "const": "violation"
        },
        "violations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "violation.schema.json"
          }
        }
      }
    },
    "Clean": {
      "description": "Rule holds against what was examined",
      "$ref": "#/$defs/Audited",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "const": "clean"
        },
        "violations": false
      }
    },
    "NotApplicable": {
      "description": "Rule cannot apply to what is under review",
      "$ref": "#/$defs/Audited",
      "required": [
        "verdict"
      ],
      "properties": {
        "verdict": {
          "const": "not-applicable"
        },
        "violations": false
      }
    },
    "Audited": {
      "description": "Examined artifacts and [[Evidence]] required on every row",
      "type": "object",
      "required": [
        "examined",
        "evidence"
      ],
      "properties": {
        "examined": {
          "$ref": "#/$defs/Examined"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      }
    },
    "Examined": {
      "description": "Files, symbols, tests, or queries opened to reach the verdict",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ExaminedItem"
      }
    },
    "ExaminedItem": {
      "description": "One artifact or search query examined",
      "type": "string",
      "minLength": 1
    },
    "Evidence": {
      "description": "Verifiable [[Evidence]] grounding the verdict",
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
      "rows": [
        {
          "rule": "No suppressed exit status",
          "examined": [
            "scripts/verify.sh"
          ],
          "verdict": "clean",
          "evidence": "Every command in scripts/verify.sh:1-12 runs under set -euo pipefail without suppression."
        }
      ]
    }
  ]
}
