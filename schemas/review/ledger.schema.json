{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/review/ledger.schema.json",
  "title": "Ledger",
  "description": "The completeness record of a review, of which there is one: one row per rule probed, naming what was opened, the verdict reached, [[Evidence]], and any [[Violation]]s",
  "type": "object",
  "required": [
    "headCommit",
    "rows"
  ],
  "properties": {
    "headCommit": {
      "$ref": "change.schema.json#/$defs/HeadCommit"
    },
    "rows": {
      "$ref": "#/$defs/Rows"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Observation": {
      "description": "A concise description of the concrete code defect alone, worded as the subject completing '{observation} breaks {principle name}'",
      "type": "string",
      "minLength": 1
    },
    "RuleHeading": {
      "description": "The heading of a rule in its ruleset",
      "type": "string",
      "minLength": 1
    },
    "RulesetUrl": {
      "description": "A ruleset from outside our rules, by its canonical URL",
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "BookRule": {
      "description": "An external rulebook rule identified by its canonical ruleset URL and section heading",
      "type": "object",
      "required": [
        "ruleset",
        "heading"
      ],
      "properties": {
        "ruleset": {
          "$ref": "#/$defs/RulesetUrl"
        },
        "heading": {
          "$ref": "#/$defs/RuleHeading"
        }
      },
      "additionalProperties": false
    },
    "RuleRef": {
      "description": "The rule broken: one of our rules by [[Id]], or an external rulebook rule",
      "oneOf": [
        {
          "$ref": "../governance/rules.schema.json#/$defs/RuleId"
        },
        {
          "$ref": "#/$defs/BookRule"
        }
      ]
    },
    "Violation": {
      "description": "A finding that code on the [[Surface]] breaks a [[Rule]]: the rule id, the surface line id (idToReportViolationOn, omitted when the finding applies to the pull request as a whole), and the description of the violation",
      "type": "object",
      "required": [
        "rule",
        "observation"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/RuleRef"
        },
        "idToReportViolationOn": {
          "$ref": "change.schema.json#/$defs/SurfaceLine/properties/idToReportViolationOn"
        },
        "observation": {
          "$ref": "#/$defs/Observation"
        }
      },
      "additionalProperties": false
    },
    "ViolationsList": {
      "description": "Every finding on the rule when the verdict is violation",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Violation"
      }
    },
    "Examined": {
      "description": "One thing opened to reach the verdict: a file, a symbol, a call site, a test file including the case where none exists, or a search with its query",
      "type": "string",
      "minLength": 1
    },
    "ExaminedList": {
      "description": "Every file, symbol, search query, or missing context resource inspected to reach the verdict",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Examined"
      }
    },
    "Evidence": {
      "description": "Verifiable [[Evidence]] that the verdict rests on; the verdict it sits in says what it has to name",
      "type": "string",
      "minLength": 1
    },
    "RuleViolationRow": {
      "description": "A violation verdict reached on one of our rules by [[Id]]",
      "type": "object",
      "required": [
        "rule",
        "examined",
        "verdict",
        "evidence",
        "violations"
      ],
      "properties": {
        "rule": {
          "$ref": "../governance/rules.schema.json#/$defs/RuleId"
        },
        "examined": {
          "$ref": "#/$defs/ExaminedList"
        },
        "verdict": {
          "const": "violation"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "violations": {
          "$ref": "#/$defs/ViolationsList"
        }
      },
      "additionalProperties": false
    },
    "BookRuleViolationRow": {
      "description": "A violation verdict reached by the context probe on one rule of the ruleset it selected",
      "type": "object",
      "required": [
        "bookRule",
        "examined",
        "verdict",
        "evidence",
        "violations"
      ],
      "properties": {
        "bookRule": {
          "$ref": "#/$defs/BookRule"
        },
        "examined": {
          "$ref": "#/$defs/ExaminedList"
        },
        "verdict": {
          "const": "violation"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "violations": {
          "$ref": "#/$defs/ViolationsList"
        }
      },
      "additionalProperties": false
    },
    "RulePassRow": {
      "description": "A clean or not-applicable verdict reached on one of our rules by [[Id]]",
      "type": "object",
      "required": [
        "rule",
        "examined",
        "verdict",
        "evidence"
      ],
      "properties": {
        "rule": {
          "$ref": "../governance/rules.schema.json#/$defs/RuleId"
        },
        "examined": {
          "$ref": "#/$defs/ExaminedList"
        },
        "verdict": {
          "enum": [
            "clean",
            "not-applicable"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "additionalProperties": false
    },
    "BookRulePassRow": {
      "description": "A clean or not-applicable verdict reached by the context probe on one rule of the ruleset it selected",
      "type": "object",
      "required": [
        "bookRule",
        "examined",
        "verdict",
        "evidence"
      ],
      "properties": {
        "bookRule": {
          "$ref": "#/$defs/BookRule"
        },
        "examined": {
          "$ref": "#/$defs/ExaminedList"
        },
        "verdict": {
          "enum": [
            "clean",
            "not-applicable"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "additionalProperties": false
    },
    "Row": {
      "description": "One probe's result on one rule: a rule of ours, or a rule of a ruleset from outside ours",
      "oneOf": [
        {
          "$ref": "#/$defs/RuleViolationRow"
        },
        {
          "$ref": "#/$defs/BookRuleViolationRow"
        },
        {
          "$ref": "#/$defs/RulePassRow"
        },
        {
          "$ref": "#/$defs/BookRulePassRow"
        }
      ]
    },
    "Rows": {
      "description": "One row per rule probed: the rows of each probe in the order of its instructions",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Row"
      }
    }
  },
  "examples": [
    {
      "headCommit": "e2bde7afe2f2b1ffc23cdb6f0dc00601b4868eb7",
      "rows": [
        {
          "rule": "Scripts abort on error",
          "examined": [
            "scripts/verify.sh",
            "build.sh"
          ],
          "verdict": "clean",
          "evidence": "Both scripts run under set -euo pipefail, and no step is wrapped in a construct that would let the script continue."
        },
        {
          "rule": "No suppressed exit status",
          "examined": [
            "scripts/verify.sh"
          ],
          "verdict": "violation",
          "evidence": "scripts/verify.sh:21 pipes the check into tail, so its status is lost.",
          "violations": [
            {
              "rule": "No suppressed exit status",
              "idToReportViolationOn": "scripts/verify.sh:21",
              "observation": "Losing the check's exit status in a pipe into tail"
            }
          ]
        },
        {
          "bookRule": {
            "ruleset": "https://github.com/ciembor/agent-rules-books/blob/main/domain-driven-design/domain-driven-design.md",
            "heading": "Make implicit concepts explicit"
          },
          "examined": [
            "scripts/verify.sh"
          ],
          "verdict": "clean",
          "evidence": "The change adds one check to a script and introduces no domain concept that could be left implicit."
        }
      ]
    }
  ]
}
