{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "definition-key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "definitions"
  ],
  "additionalProperties": false,
  "properties": {
    "definitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/definition-key"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "term",
          "specification"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "$ref": "#/$defs/text"
          },
          "specification": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
