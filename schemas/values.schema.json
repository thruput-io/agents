{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/values.schema.json",
  "title": "Values",
  "description": "The values: the root entries of the taxonomy, which have no parent",
  "examples": [
    {
      "values": [
        {
          "id": "Outcome Over Output",
          "body": "We value customer collaboration over following a rigid plan.\n"
        }
      ]
    }
  ],
  "type": "object",
  "required": [
    "values"
  ],
  "properties": {
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Value"
      }
    }
  },
  "$defs": {
    "Value": {
      "description": "One value",
      "$ref": "entry.schema.json#/$defs/RootEntry",
      "properties": {
        "id": {
          "$ref": "#/$defs/ValueId"
        }
      }
    },
    "ValueId": {
      "$ref": "id.schema.json"
    }
  }
}
