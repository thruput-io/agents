{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput-io.github.io/agents/schemas/values.schema.json",
  "title": "Values",
  "type": "object",
  "required": [
    "values"
  ],
  "properties": {
    "values": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Value"
      }
    }
  },
  "$defs": {
    "Value": {
      "description": "One value.",
      "allOf": [
        {
          "$ref": "entry.schema.json#/$defs/RootEntry"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ValueId"
        }
      }
    },
    "ValueId": {
      "allOf": [
        {
          "$ref": "id.schema.json#/$defs/Id"
        }
      ]
    }
  }
}
