{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/governance/rules.schema.json",
  "title": "Rules",
  "description": "The rules: entries whose parent is a principle, expressed in Ubiquitous Language (uql) and placed in a group",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "references": {
      "$ref": "ubiquitous-language.schema.json#/$defs/References"
    }
  },
  "$defs": {
    "Rule": {
      "description": "One rule",
      "$ref": "entry.schema.json#/$defs/Entry",
      "required": [
        "id",
        "body",
        "parent",
        "group"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/RuleId"
        },
        "body": {
          "$ref": "ubiquitous-language.schema.json#/$defs/UbiquitousLanguage"
        },
        "parent": {
          "$ref": "principles.schema.json#/$defs/PrincipleId"
        },
        "marker": {
          "enum": [
            "MUST",
            "MUST NOT"
          ]
        },
        "group": {
          "$ref": "#/$defs/Group"
        },
        "smells": {
          "$ref": "#/$defs/Smells"
        },
        "references": {
          "$ref": "ubiquitous-language.schema.json#/$defs/References"
        }
      }
    },
    "Smells": {
      "description": "Code smells that indicate this rule is being violated",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ubiquitous-language.schema.json#/$defs/UbiquitousLanguage"
      }
    },
    "RuleId": {
      "$ref": "id.schema.json"
    },
    "Group": {
      "description": "The group a rule is placed in, by its name",
      "type": "string",
      "minLength": 1
    }
  },
  "examples": [
    {
      "rules": [
        {
          "id": "Example rule",
          "group": "Example group",
          "parent": "Example principle",
          "body": "Production Code contains no Dead Code."
        }
      ]
    }
  ]
}
