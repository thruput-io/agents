{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/governance/governance.schema.json",
  "title": "Governance",
  "description": "Any one governance document: exactly one of the document schemas it lists applies, told apart by the document's top-level key",
  "oneOf": [
    {
      "$ref": "values.schema.json"
    },
    {
      "$ref": "axioms.schema.json"
    },
    {
      "$ref": "rationales.schema.json"
    },
    {
      "$ref": "principles.schema.json"
    },
    {
      "$ref": "rules.schema.json"
    },
    {
      "$ref": "standards.schema.json"
    },
    {
      "$ref": "definitions.schema.json"
    },
    {
      "$ref": "taxonomy.schema.json"
    }
  ],
  "examples": [
    {
      "axioms": [
        {
          "id": "Example axiom",
          "parent": "Example value",
          "body": "An example axiom states a truth we hold."
        }
      ]
    }
  ]
}
