{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/governance/rationales.schema.json",
  "title": "Rationales",
  "description": "The rationales: entries whose parent is an axiom, with any solutions that apply them",
  "type": "object",
  "required": [
    "rationales"
  ],
  "properties": {
    "rationales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rationale"
      }
    },
    "references": {
      "$ref": "ubiquitous-language.schema.json#/$defs/References"
    }
  },
  "$defs": {
    "Rationale": {
      "description": "One rationale",
      "$ref": "entry.schema.json#/$defs/Entry",
      "properties": {
        "id": {
          "$ref": "#/$defs/RationaleId"
        },
        "parent": {
          "$ref": "axioms.schema.json#/$defs/AxiomId"
        },
        "solutions": {
          "$ref": "#/$defs/Solutions"
        },
        "references": {
          "$ref": "ubiquitous-language.schema.json#/$defs/References"
        }
      }
    },
    "Solutions": {
      "description": "Ways to apply the rationale. Each states how in Ubiquitous Language (uql), never restates a principle, and is phrased positively",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Solution"
      }
    },
    "Solution": {
      "description": "One way to apply the rationale in Ubiquitous Language (uql)",
      "type": "object",
      "required": [
        "body"
      ],
      "properties": {
        "marker": {
          "enum": [
            "SHOULD",
            "MAY"
          ]
        },
        "body": {
          "$ref": "ubiquitous-language.schema.json#/$defs/UbiquitousLanguage"
        }
      }
    },
    "RationaleId": {
      "$ref": "id.schema.json"
    }
  },
  "examples": [
    {
      "rationales": [
        {
          "id": "Example rationale",
          "parent": "Example axiom",
          "body": "An example rationale weighs two goods and cites its source.",
          "solutions": [
            {
              "body": "Each boundary applies the example rationale."
            }
          ]
        }
      ]
    }
  ]
}
