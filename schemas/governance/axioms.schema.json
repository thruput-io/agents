{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/governance/axioms.schema.json",
  "title": "Axioms",
  "description": "The axioms: entries whose parent is a value",
  "type": "object",
  "required": [
    "axioms"
  ],
  "properties": {
    "axioms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Axiom"
      }
    }
  },
  "$defs": {
    "Axiom": {
      "description": "One axiom",
      "$ref": "entry.schema.json#/$defs/Entry",
      "properties": {
        "id": {
          "$ref": "#/$defs/AxiomId"
        },
        "parent": {
          "$ref": "values.schema.json#/$defs/ValueId"
        }
      }
    },
    "AxiomId": {
      "$ref": "id.schema.json"
    }
  },
  "examples": [
    {
      "axioms": [
        {
          "id": "Example axiom",
          "parent": "Example value",
          "body": "An example axiom states a truth we hold."
        }
      ]
    }
  ]
}
