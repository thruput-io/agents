{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/governance/entry.schema.json",
  "title": "Entry",
  "description": "What every entry in the taxonomy carries: an id and a body in Ubiquitous Language (uql), optional References, and below the root the id of its parent one level up. Each level schema extends an entry and narrows its id and its parent to its own level",
  "oneOf": [
    {
      "$ref": "#/$defs/RootEntry"
    },
    {
      "$ref": "#/$defs/Entry"
    }
  ],
  "$defs": {
    "RootEntry": {
      "description": "An entry at the root level, which has no parent",
      "type": "object",
      "required": [
        "id",
        "body"
      ],
      "properties": {
        "id": {
          "$ref": "id.schema.json"
        },
        "body": {
          "$ref": "ubiquitous-language.schema.json#/$defs/UbiquitousLanguage"
        },
        "references": {
          "$ref": "ubiquitous-language.schema.json#/$defs/References"
        },
        "parent": false
      }
    },
    "Entry": {
      "description": "An entry below the root, pointing at its parent one level up",
      "type": "object",
      "required": [
        "id",
        "body",
        "parent"
      ],
      "properties": {
        "id": {
          "$ref": "id.schema.json"
        },
        "body": {
          "$ref": "ubiquitous-language.schema.json#/$defs/UbiquitousLanguage"
        },
        "references": {
          "$ref": "ubiquitous-language.schema.json#/$defs/References"
        },
        "parent": {
          "$ref": "id.schema.json"
        }
      }
    }
  },
  "examples": [
    {
      "id": "Example entry",
      "parent": "Example parent",
      "body": "An example entry states its body once."
    }
  ]
}
