{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/principles.schema.json",
  "title": "Principles",
  "description": "The principles: entries whose parent is a rationale",
  "examples": [
    {
      "principles": [
        {
          "id": "Producer moves first",
          "parent": "Robustness Principle",
          "body": "The producer moves first; consumers accept what they do not know.\n"
        }
      ]
    }
  ],
  "type": "object",
  "required": [
    "principles"
  ],
  "properties": {
    "principles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Principle"
      }
    }
  },
  "$defs": {
    "Principle": {
      "description": "One principle",
      "$ref": "entry.schema.json#/$defs/Entry",
      "properties": {
        "id": {
          "$ref": "#/$defs/PrincipleId"
        },
        "parent": {
          "$ref": "rationales.schema.json#/$defs/RationaleId"
        }
      }
    },
    "PrincipleId": {
      "$ref": "id.schema.json"
    }
  }
}
