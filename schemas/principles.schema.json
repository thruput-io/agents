{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput-io.github.io/agents/schemas/principles.schema.json",
  "title": "Principles",
  "type": "object",
  "required": [
    "principles"
  ],
  "properties": {
    "principles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Principle"
      }
    }
  },
  "$defs": {
    "Principle": {
      "description": "One principle.",
      "allOf": [
        {
          "$ref": "entry.schema.json#/$defs/Entry"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/PrincipleId"
        },
        "parent": {
          "$ref": "rationales.schema.json#/$defs/RationaleId"
        }
      }
    },
    "PrincipleId": {
      "allOf": [
        {
          "$ref": "id.schema.json#/$defs/Id"
        }
      ]
    }
  }
}
