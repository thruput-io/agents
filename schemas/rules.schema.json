{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput.se/agents/schemas/rules.schema.json",
  "title": "Rules",
  "description": "The rules: entries whose parent is a principle, each opened by a marker and placed in a group",
  "examples": [
    {
      "rules": [
        {
          "id": "Example rule",
          "marker": "MUST",
          "group": "Example group",
          "parent": "Example principle",
          "body": "Name the bad code the example rule forbids."
        }
      ]
    }
  ],
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    }
  },
  "$defs": {
    "Rule": {
      "description": "One rule",
      "$ref": "entry.schema.json#/$defs/Entry",
      "required": [
        "marker",
        "group"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/RuleId"
        },
        "parent": {
          "$ref": "principles.schema.json#/$defs/PrincipleId"
        },
        "marker": {
          "enum": [
            "MUST",
            "MUST NOT"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RuleId": {
      "$ref": "id.schema.json"
    }
  }
}
