{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thruput-io.github.io/agents/schemas/rules.schema.json",
  "title": "Rules",
  "type": "object",
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Rule"
      }
    }
  },
  "$defs": {
    "Rule": {
      "description": "One rule.",
      "allOf": [
        {
          "$ref": "entry.schema.json#/$defs/Entry"
        }
      ],
      "required": [
        "marker",
        "group"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/RuleId"
        },
        "parent": {
          "$ref": "principles.schema.json#/$defs/PrincipleId"
        },
        "marker": {
          "enum": [
            "MUST",
            "MUST NOT",
            "SHOULD",
            "SHOULD NOT",
            "MAY",
            "PREFER"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RuleId": {
      "allOf": [
        {
          "$ref": "id.schema.json#/$defs/Id"
        }
      ]
    }
  }
}
