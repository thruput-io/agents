{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "rule-key": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "principle-key": {
      "enum": [
        "quality-uncompromised",
        "code-only-for-user-value",
        "code-as-a-subset-of-the-why",
        "the-simplicity-ladder",
        "convention-over-novelty",
        "shift-left",
        "durable-intent-over-comments",
        "loud-failures-over-silent-defaults",
        "orphans"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/rule-key"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "marker",
          "group",
          "guards",
          "body"
        ],
        "additionalProperties": false,
        "properties": {
          "marker": {
            "enum": [
              "MUST",
              "MUST NOT",
              "SHOULD",
              "SHOULD NOT",
              "MAY",
              "PREFER"
            ]
          },
          "group": {
            "$ref": "#/$defs/text"
          },
          "guards": {
            "$ref": "#/$defs/principle-key"
          },
          "body": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}
